rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'lelimei88@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Consultation inquiries
    function isValidConsultation(data) {
      return data.keys().hasAll(['name', 'whatsapp', 'email', 'packageInterest']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.whatsapp is string && data.whatsapp.size() >= 6 && data.whatsapp.size() <= 30 &&
        data.email is string && data.email.size() <= 100 &&
        data.packageInterest is string && data.packageInterest.size() <= 100 &&
        (!('message' in data) || (data.message is string && data.message.size() <= 1000)) &&
        (!('status' in data) || (data.status in ['pending', 'contacted', 'resolved']));
    }

    match /consultations/{consultationId} {
      allow create: if isValidId(consultationId) && isValidConsultation(incoming());
      allow read, update, delete: if isAdmin();
    }

    // Career applications
    function isValidCareerApplication(data) {
      return data.keys().hasAll(['positionTitle', 'applicantName', 'whatsapp', 'email']) &&
        data.positionTitle is string && data.positionTitle.size() <= 100 &&
        data.applicantName is string && data.applicantName.size() >= 2 && data.applicantName.size() <= 100 &&
        data.whatsapp is string && data.whatsapp.size() >= 6 && data.whatsapp.size() <= 30 &&
        data.email is string && data.email.size() <= 100 &&
        (!('experience' in data) || (data.experience is string && data.experience.size() <= 500)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('status' in data) || (data.status in ['received', 'reviewing', 'interview', 'rejected']));
    }

    match /careerApplications/{applicationId} {
      allow create: if isValidId(applicationId) && isValidCareerApplication(incoming());
      allow read, update, delete: if isAdmin();
    }

    // User profiles
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 100 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('role' in data) || (data.role in ['user', 'partner', 'admin']));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUserProfile(incoming()) && 
        (!('role' in incoming()) || incoming().role != 'admin');
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && 
        (!('role' in incoming()) || !('role' in existing()) || incoming().role == existing().role);
      allow delete: if isAdmin();
    }
  }
}
